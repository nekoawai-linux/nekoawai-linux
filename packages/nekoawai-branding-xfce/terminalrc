#
# What xfce4-terminal opens with on a machine where nobody has changed it.
# The colours are the NekoAwai palette, the same sixteen the text console is
# given in nekoawai-defaults: a terminal in a session and a terminal on tty2
# should not be two different rooms.
#
# Red, green, yellow, blue and cyan keep their meanings -- a build log that
# has gone red has to look it -- and the magenta pair is the accent the rest
# of the system is written in.
#
# The first change a user makes writes ~/.config/xfce4/terminal/terminalrc
# and this file stops being consulted.
#

[Configuration]
ColorForeground=#e9e4f2
ColorBackground=#15121c
ColorCursor=#e05a95
ColorSelection=#e9e4f2
ColorSelectionBackground=#3a3350
ColorPalette=#15121c;#e0566b;#7fbf7a;#daaa3f;#8a86d6;#e05a95;#63bcc0;#e9e4f2;#5f596e;#ec6e80;#93d18d;#e8c065;#a29ee6;#ec6ea5;#7fd0d4;#ffffff
ScrollingLines=10000
